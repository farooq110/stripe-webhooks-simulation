# Copy this file to .env and adjust what you need.
# Everything here is optional — the app works with zero config in simulator mode.

# ── Gateway ──────────────────────────────────────────────────────────────────

# "sim" = built-in simulator (default, no Stripe account needed).
# "live" = real Stripe SDK calls. Requires STRIPE_SECRET_KEY below.
STRIPE_GATEWAY_MODE=sim

# Stripe TEST secret key. If set and it starts with sk_test_, live mode turns on
# by itself. Never put a live (sk_live_) key in this file.
STRIPE_SECRET_KEY=

# Webhook signing secret for live mode — the whsec_... value printed by:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Live webhooks are verified by the official Stripe SDK against this secret.
STRIPE_WEBHOOK_SECRET=

# Signing secret the simulator uses when it signs webhook payloads. Kept
# strictly separate from STRIPE_WEBHOOK_SECRET: a sim signature can never be
# accepted as a live Stripe signature (and vice versa), because verification
# always uses the secret of the active gateway mode.
# Leave empty and the app generates a random one per start (nothing public is
# shipped in the repo). Set your own random value (openssl rand -hex 32) if you
# want to sign test webhooks from scripts — the scripts must use the same value.
STRIPE_SIM_WEBHOOK_SECRET=

# Public URL of the app, used for checkout redirects.
APP_URL=http://127.0.0.1:3000

# ── Access control ───────────────────────────────────────────────────────────

# Optional: if set, every mutating /api/demo/* endpoint requires the header
#   x-demo-token: <value>
# Use this on public deployments. Leave empty for the interactive dashboard.
DEMO_API_TOKEN=

# ── Operational settings (all optional, sane defaults) ──────────────────────

# Smart-retry attempts before a subscription is marked unpaid.
# MAX_PAYMENT_RETRIES=3
# Base delay between dunning attempts (ms) — same exponential ladder as webhooks.
# PAYMENT_RETRY_BACKOFF_MS=6000

# Webhook redeliveries before an event moves to the dead-letter state
# (status "dead", visible in /api/state, requeue manually via
# POST /api/demo/requeue { eventId }).
# WEBHOOK_MAX_REDELIVERIES=6
# Webhook redelivery backoff: WEBHOOK_BACKOFF_BASE_MS × 2^(attempt−1),
# capped at WEBHOOK_BACKOFF_MAX_MS.
# WEBHOOK_BACKOFF_BASE_MS=2000
# WEBHOOK_BACKOFF_MAX_MS=30000
# How long a processing claim stays valid before a crashed worker's event or
# retry job is reclaimed (ms).
# WEBHOOK_CLAIM_TTL_MS=30000
# How long a concurrent webhook delivery waits for the worker holding the claim (ms).
# WEBHOOK_SIBLING_WAIT_MS=12000
# Signature timestamp tolerance (Stripe uses 300s).
# WEBHOOK_TOLERANCE_SECONDS=300

# How often the Stripe ↔ MongoDB reconciliation runs (ms). 0 disables it.
# RECONCILE_INTERVAL_MS=60000

# Live Stripe API client: per-call timeout and SDK-level network retries.
# STRIPE_API_TIMEOUT_MS=15000
# STRIPE_API_MAX_RETRIES=2
