# Copy this file to .env and adjust what you need.
# Everything here is optional — the app works with zero config in simulator mode.

# "sim" = built-in simulator (default, no Stripe account needed).
# "live" = real Stripe SDK calls. Requires STRIPE_SECRET_KEY below.
STRIPE_GATEWAY_MODE=sim

# Stripe TEST secret key. If set and it starts with sk_test_, live mode turns on
# by itself. Never put a live (sk_live_) key in this file.
STRIPE_SECRET_KEY=

# Webhook signing secret for live mode — the whsec_... value printed by:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Signing secret the simulator uses when it signs webhook payloads.
# Any random string works. Default matches what the code falls back to.
STRIPE_SIM_WEBHOOK_SECRET=whsec_sim_5f4dcc3b5aa765d61d8327deb882cf99

# Public URL of the app, used for checkout redirects.
APP_URL=http://127.0.0.1:3000
